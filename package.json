{
  "name": "plataforma-clube-broto",
  "version": "1.5.0",
  "private": true,
  "description": "Plataforma de Administração e Gestão do Clube Broto",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "prisma generate && node scripts/preparar-banco-deploy.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "guia:gerar": "tsx --tsconfig tsconfig.json scripts/gerar-guia-autonomo.ts",
    "job:diario": "tsx --tsconfig tsconfig.json scripts/executar-job-diario.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "publicHoistPattern": [
      "*eslint*"
    ],
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "d3-geo": "^3.1.1",
    "exceljs": "^4.4.0",
    "next": "^15.4.0",
    "next-auth": "5.0.0-beta.29",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.54.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.4.0",
    "prisma": "^6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
