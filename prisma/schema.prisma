// =====================================================================
// Schema da Plataforma de Administração do Clube Broto — Ondas 1, 2, 4 e 5
// Fontes da verdade funcionais:
//   Onda 1: docs/especificacao/ficha-onda1-aliados-solucoes-ofertas.md (v0.6)
//   Onda 2: docs/especificacao/ficha-onda2-mercado-scout.md (v0.1)
//   Onda 4: docs/especificacao/ficha-onda4-campanhas-cestas.md (v0.1, RN38–RN45)
//   Onda 5: docs/especificacao/ficha-onda5-assinantes.md (v0.1, RN29–RN37)
// Decisões estruturais: prompts das ondas em docs/especificacao/.
//
// Convenções:
// - Modelos e campos em português; tabelas/colunas em snake_case via @map.
// - Taxonomias da v1 são TABELAS com seed (dados, não enums de código),
//   para o Parametrizador da Onda 3 editá-las sem migração.
// - Pendências de negócio [A CONFIRMAR] ficam isoladas e comentadas —
//   nunca resolvidas por suposição aqui.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Identidade e RBAC (papéis da ficha §2)
// ---------------------------------------------------------------------

enum Papel {
  GESTOR
  ANALISTA
  /// Onda 2 (ficha §2): scout — radar, avaliação, priorização, dossiê.
  ANALISTA_SCOUT
  /// Onda 2 (ficha §2): negociação, registro de andamento e pedido de promoção.
  COMERCIAL
  APROVADOR
  LEITURA
  /// Onda 3 (ficha §2, RN23): único papel com escrita no Parametrizador e
  /// na definição de metas. Os demais leem o hub por transparência da
  /// configuração vigente. A gestão completa de usuários fica na Onda 6.
  ADMINISTRADOR_PLATAFORMA
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  papel        Papel
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  auditoriaEventos      AuditoriaEvento[]
  solicitacoesCriadas   AprovacaoSolicitacao[]    @relation("solicitante")
  solicitacoesDecididas AprovacaoSolicitacao[]    @relation("aprovador")
  regrasDesignadas      AprovacaoRegraAprovador[]
  publicacoes           Publicacao[]
  importacoes           Importacao[]
  empresasComoScout     Empresa[]                 @relation("responsavelScout")
  empresasComoComercial Empresa[]                 @relation("responsavelComercial")
  notasRapidas          NotaRapida[]
  registrosNegociacao   RegistroNegociacao[]
  avaliacoesScout       AvaliacaoScout[]
  segmentos             Segmento[]
  exportacoesLista      ExportacaoLista[]
  dossiesSolicitados    Dossie[]                  @relation("dossieSolicitante")
  dossiesRevisados      Dossie[]                  @relation("dossieRevisor")
  indicadoresDeclarados IndicadorDeclarado[]
  alteracoesDeValor     ValorRegraHistorico[]
  versoesDeConfiguracao ConfiguracaoVersao[]
  campanhas             Campanha[]
  cestas                Cesta[]
  kits                  KitCampanha[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------
// Taxonomias v1 — tabelas com seed (Parametrizador edita na Onda 3)
// ---------------------------------------------------------------------

model Categoria {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  empresas EmpresaCategoria[]
  solucoes Solucao[]
  metas    MetaPeriodo[]

  @@map("categorias")
}

model Cultura {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  solucoes SolucaoCultura[]

  @@map("culturas")
}

model Uf {
  id    String  @id @default(cuid())
  sigla String  @unique
  nome  String  @unique
  ativa Boolean @default(true)

  solucoes SolucaoUf[]

  @@map("ufs")
}

model TipoBeneficio {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  ofertas            Oferta[]
  ofertasPretendidas OfertaPretendida[]

  @@map("tipos_beneficio")
}

model Mecanica {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  ofertas            Oferta[]
  ofertasPretendidas OfertaPretendida[]

  @@map("mecanicas")
}

/// Motivos tipificados de suspensão de aliado (RN12). Lista editável no
/// Parametrizador; "outros" exige descrição na Empresa.
model MotivoSuspensao {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  empresas Empresa[]

  @@map("motivos_suspensao")
}

/// Motivos tipificados de descarte no funil (RN17, ficha Onda 2 §4).
/// Lista editável no Parametrizador (Onda 3); "OUTRO" exige descrição.
model MotivoDescarte {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativa Boolean @default(true)

  empresas Empresa[]

  @@map("motivos_descarte")
}

// ---------------------------------------------------------------------
// Empresa (Aliado quando estágio = ALIADA_ATIVA) — ficha §3.1
// ---------------------------------------------------------------------

/// Estágios do pipeline completo (ficha v0.6 + ficha Onda 2 §3.1 e
/// protótipo v6.1): funil pré-aliança MAPEADA → EM_AVALIACAO → PRIORIZADA →
/// EM_NEGOCIACAO → EM_APROVACAO → ALIADA_ATIVA; DESCARTADA sai do funil com
/// motivo tipificado (RN17) e pode ser reativada para MAPEADA.
enum EstagioEmpresa {
  MAPEADA
  EM_AVALIACAO
  PRIORIZADA
  EM_NEGOCIACAO
  EM_APROVACAO
  ALIADA_ATIVA
  SUSPENSA
  ENCERRADA
  DESCARTADA
}

/// Origem da entrada no radar (RN13). Valores da ficha da Onda 2 §3.1 —
/// os exemplos do protótipo são ilustrativos; a ficha vence.
enum OrigemEmpresa {
  SCOUTING_ATIVO
  INDICACAO
  PROCURA_ESPONTANEA
  LISTA_IMPORTADA
}

model Empresa {
  id                       String           @id @default(cuid())
  razaoSocial              String?          @map("razao_social")
  nomeFantasia             String           @map("nome_fantasia")
  /// Único e com validação de dígito no serviço de domínio (RN08).
  /// Opcional apenas em estágio pré-aliança (obrigatório em M2 — promoção).
  cnpj                     String?          @unique
  // Endereço da sede — mínimo contratual, obrigatório para Aliada ativa
  enderecoCep              String?          @map("endereco_cep")
  enderecoLogradouro       String?          @map("endereco_logradouro")
  enderecoNumero           String?          @map("endereco_numero")
  enderecoComplemento      String?          @map("endereco_complemento")
  enderecoBairro           String?          @map("endereco_bairro")
  enderecoMunicipio        String?          @map("endereco_municipio")
  enderecoUf               String?          @map("endereco_uf")
  logoUrl                  String?          @map("logo_url")
  descricaoInstitucional   String?          @map("descricao_institucional")
  site                     String?
  dataEntrada              DateTime?        @map("data_entrada") @db.Date
  estagio                  EstagioEmpresa   @default(EM_NEGOCIACAO)
  /// Suspensão exige motivo tipificado (RN12); "outros" exige descrição.
  motivoSuspensaoId        String?          @map("motivo_suspensao_id")
  motivoSuspensaoDescricao String?          @map("motivo_suspensao_descricao")
  // --- Funil de mercado (Onda 2, ficha §3.1) ---
  /// Obrigatória na entrada pelo radar (RN13, validada em serviço); vazia
  /// nas empresas anteriores à Onda 2 (carga inicial e cadastro T2).
  origem                   OrigemEmpresa?
  /// Um dos 2 analistas de scout — atribuído ao assumir a avaliação (RN14).
  responsavelScoutId       String?          @map("responsavel_scout_id")
  /// Um dos 8 comerciais — designado no handoff para negociação (RN16).
  responsavelComercialId   String?          @map("responsavel_comercial_id")
  dataEntradaRadar         DateTime?        @map("data_entrada_radar") @db.Date
  /// Início do estágio atual ("há N dias" na T8). Nulo para empresas
  /// anteriores ao rastreamento da F6 — exibido como "—", nunca estimado.
  estagioDesde             DateTime?        @map("estagio_desde")
  /// Descarte exige motivo tipificado (RN17); "OUTRO" exige descrição.
  /// Limpos na reativação (histórico preservado na auditoria).
  motivoDescarteId         String?          @map("motivo_descarte_id")
  motivoDescarteDescricao  String?          @map("motivo_descarte_descricao")
  motivoDescarteComentario String?          @map("motivo_descarte_comentario")
  /// Total 0–100 da avaliação fechada vigente (F7); recalculado a cada
  /// fechamento de versão. Nulo = sem avaliação fechada ("pendente").
  scoreScouting            Int?             @map("score_scouting")
  /// RN21 — ligada pelo job diário quando a aliada ativa completa 12 meses
  /// da última avaliação fechada; limpa ao fechar nova avaliação (ou pelo
  /// próprio job quando deixar de valer).
  reavaliacaoPendente      Boolean          @default(false) @map("reavaliacao_pendente")
  // --- Ficha Cadastral do Aliado v1, seções A e B (M1, Onda 2/F9) ---
  /// Até 5 itens curtos — substitui o parágrafo livre do Word (seção A).
  diferenciais             String[]         @default([])
  /// Taxonomia herdada do scouting (SaaS, serviço, contrato a prazo…),
  /// texto livre tipado na v1; vira lista de domínio na Onda 3.
  modeloNegocio            String?          @map("modelo_negocio")
  /// Público-alvo em DOIS eixos (seção B): porte do produtor e natureza —
  /// o caso Viasat mostrou que um eixo só não basta.
  publicoPorte             PorteProdutor[]  @map("publico_porte")
  publicoNatureza          NaturezaPublico? @map("publico_natureza")
  /// Preenchido na primeira publicação; na carga inicial vem da planilha ("Id do Seller").
  idExternoMinutrade       String?          @unique @map("id_externo_minutrade")
  criadoEm                 DateTime         @default(now()) @map("criado_em")
  atualizadoEm             DateTime         @updatedAt @map("atualizado_em")

  motivoSuspensao       MotivoSuspensao?     @relation(fields: [motivoSuspensaoId], references: [id])
  motivoDescarte        MotivoDescarte?      @relation(fields: [motivoDescarteId], references: [id])
  responsavelScout      Usuario?             @relation("responsavelScout", fields: [responsavelScoutId], references: [id])
  responsavelComercial  Usuario?             @relation("responsavelComercial", fields: [responsavelComercialId], references: [id])
  categorias            EmpresaCategoria[]
  contatos              ContatoEmpresa[]
  contratos             ContratoComercial[]
  solucoes              Solucao[]
  notasRapidas          NotaRapida[]
  registrosNegociacao   RegistroNegociacao[]
  avaliacoesScout       AvaliacaoScout[]
  dossies               Dossie[]
  indicadoresDeclarados IndicadorDeclarado[]
  ofertasPretendidas    OfertaPretendida[]

  @@index([estagio])
  @@map("empresas")
}

/// Notas rápidas da empresa no funil (ficha Onda 2 §3.1): texto livre
/// curto, em histórico — corrigir é acrescentar nova nota.
model NotaRapida {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  autorId   String   @map("autor_id")
  texto     String
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  autor   Usuario @relation(fields: [autorId], references: [id])

  @@index([empresaId])
  @@map("notas_rapidas")
}

enum TipoRegistroNegociacao {
  REUNIAO
  PROPOSTA_ENVIADA
  FOLLOW_UP
  OUTRO
}

/// Registro simples de andamento da negociação (ficha Onda 2 §3.5) —
/// deliberadamente NÃO é um CRM (limite de escopo, ficha §9).
model RegistroNegociacao {
  id            String                 @id @default(cuid())
  empresaId     String                 @map("empresa_id")
  responsavelId String                 @map("responsavel_id")
  data          DateTime               @db.Date
  tipo          TipoRegistroNegociacao
  nota          String
  criadoEm      DateTime               @default(now()) @map("criado_em")

  empresa     Empresa @relation(fields: [empresaId], references: [id])
  responsavel Usuario @relation(fields: [responsavelId], references: [id])

  @@index([empresaId])
  @@map("registros_negociacao")
}

// ---------------------------------------------------------------------
// Avaliação de scout (Onda 2, F7) — ficha §3.2/§3.3, RN15/RN18/RN21
// ---------------------------------------------------------------------

/// As duas tabelas do ScoutCB (ficha §3.3): indicadores de Empresa e de
/// Produto.
enum GrupoIndicador {
  EMPRESA
  PRODUTO
}

/// Indicador de scouting — taxonomia com seed fiel a
/// docs/especificacao/indicadores-scoutcb-seed.md (16 de Empresa e 7 de
/// Produto nas 14 dimensões de medição); edição chega com o Parametrizador
/// (Onda 3, T16).
model Indicador {
  id        String         @id @default(cuid())
  slug      String         @unique
  nome      String         @unique
  /// Coluna "O que mede" da tabela do ScoutCB.
  descricao String
  grupo     GrupoIndicador
  /// Uma das 14 dimensões de medição (constante em
  /// dominio/avaliacao/dimensoes.ts, validada em serviço); vira lista
  /// editável na Onda 3.
  dimensao  String
  /// Pesos v1 = 1 uniforme (o ScoutCB não define pesos); a ponderação
  /// torna-se editável por dimensão no Parametrizador (F10/RN25).
  peso      Decimal        @default(1) @db.Decimal(5, 2)
  ordem     Int
  ativo     Boolean        @default(true)

  notas AvaliacaoNota[]

  @@map("indicadores")
}

enum StatusAvaliacao {
  RASCUNHO
  FECHADA
}

/// As três recomendações da ficha §3.2 — o score recomenda, nunca decide
/// (RN15): priorização e descarte seguem sendo atos humanos no funil.
enum RecomendacaoAvaliacao {
  AVANCAR
  MONITORAR
  DESCARTAR
}

/// Avaliação de scout versionada (ficha §3.2). Imutável após fechamento
/// (RN18, garantida em serviço): correção = nova versão. Subtotais e total
/// são CONGELADOS no fechamento — mudança futura de peso nunca re-pontua
/// avaliação fechada (antecipação da RN25, Onda 3).
model AvaliacaoScout {
  id                   String                 @id @default(cuid())
  empresaId            String                 @map("empresa_id")
  /// Sequencial por empresa; a vigente é a FECHADA de maior versão.
  versao               Int
  avaliadorId          String                 @map("avaliador_id")
  status               StatusAvaliacao        @default(RASCUNHO)
  recomendacao         RecomendacaoAvaliacao?
  /// Congelado no fechamento: [{dimensao, grupo, media, peso, subtotal}] —
  /// subtotal = média 1–5 das notas da dimensão × 20 (nota de consistência
  /// do seed dos indicadores).
  subtotais            Json?
  /// Total 0–100 congelado no fechamento: média dos subtotais das
  /// dimensões avaliadas ponderada pelos pesos (v1 todos 1).
  total                Int?
  fechadaEm            DateTime?              @map("fechada_em")
  /// RN25 — versão de configuração (indicadores, dimensões, pesos) usada
  /// nesta avaliação. É o que torna o efeito prospectivo verificável: uma
  /// avaliação fechada aponta para a configuração vigente à época, e nova
  /// escrita em pesos gera nova versão sem tocar nesta. Opcional apenas
  /// porque a coluna nasceu depois das avaliações da F7 (backfill aponta
  /// as existentes para a versão-seed).
  configuracaoVersaoId String?                @map("configuracao_versao_id")
  criadoEm             DateTime               @default(now()) @map("criado_em")
  atualizadoEm         DateTime               @updatedAt @map("atualizado_em")

  empresa            Empresa                @relation(fields: [empresaId], references: [id])
  avaliador          Usuario                @relation(fields: [avaliadorId], references: [id])
  notas              AvaliacaoNota[]
  /// Pedidos de promoção que levaram esta avaliação anexada (RN20).
  solicitacoes       AprovacaoSolicitacao[]
  configuracaoVersao ConfiguracaoVersao?    @relation(fields: [configuracaoVersaoId], references: [id])

  @@unique([empresaId, versao])
  @@index([empresaId, status])
  @@map("avaliacoes_scout")
}

/// Nota 1–5 por indicador com evidência opcional (ficha §3.2). A evidência
/// pode citar o dossiê, mas nenhum campo de dossiê preenche nota — a
/// pontuação é sempre humana (RN19).
model AvaliacaoNota {
  id          String  @id @default(cuid())
  avaliacaoId String  @map("avaliacao_id")
  indicadorId String  @map("indicador_id")
  /// 1–5 (validada em domínio e por CHECK no banco).
  nota        Int
  evidencia   String?

  avaliacao AvaliacaoScout @relation(fields: [avaliacaoId], references: [id])
  indicador Indicador      @relation(fields: [indicadorId], references: [id])

  @@unique([avaliacaoId, indicadorId])
  @@map("avaliacao_notas")
}

// ---------------------------------------------------------------------
// Dossiê de due diligence pública (Onda 2, F8) — ficha §3.4, §6 e RN19
// ---------------------------------------------------------------------

/// Ciclo de vida da geração assíncrona (ficha §3.4).
enum StatusDossie {
  GERANDO
  PRONTO
  FALHA
}

enum OrigemDossie {
  GERADO_IA
  INSERIDO_MANUALMENTE
}

/// Dossiê de due diligence pública da empresa (ficha §3.4). O conteúdo
/// segue as dez etapas do template versionado
/// (docs/especificacao/prompt-dossie-due-diligence.md), com fontes por
/// afirmação e "Não foi encontrada informação pública" onde faltar.
///
/// RN19: nasce com `revisado = false` ("gerado automaticamente — requer
/// revisão") e só sai desse estado por ação humana explícita, que grava
/// revisor e data. Nenhum campo daqui preenche nota de indicador — o
/// dossiê alimenta evidência; a pontuação é sempre humana (garantido em
/// serviço e verificado por teste de arquitetura).
model Dossie {
  id                String       @id @default(cuid())
  empresaId         String       @map("empresa_id")
  status            StatusDossie @default(GERANDO)
  origem            OrigemDossie
  /// Conteúdo validado contra o schema do template (dominio/dossie/schema.ts).
  /// Nulo enquanto GERANDO e quando a geração falha.
  conteudo          Json?
  /// Identificação da versão do template que originou o prompt — o
  /// template é versionado e sua alteração é alteração de produto.
  versaoTemplate    String?      @map("versao_template")
  /// Quem pediu a geração (nunca em lote: sempre sob demanda de um analista).
  solicitanteId     String       @map("solicitante_id")
  /// Notas do analista enviadas ao provedor ({{contexto_adicional}}).
  contextoAdicional String?      @map("contexto_adicional")
  /// RN19 — a marca de revisão e sua autoria.
  revisado          Boolean      @default(false)
  revisorId         String?      @map("revisor_id")
  revisadoEm        DateTime?    @map("revisado_em")
  /// Mensagem da última falha (exibida na T11 com a ação de nova tentativa).
  erro              String?
  criadoEm          DateTime     @default(now()) @map("criado_em")
  atualizadoEm      DateTime     @updatedAt @map("atualizado_em")

  empresa      Empresa                @relation(fields: [empresaId], references: [id])
  solicitante  Usuario                @relation("dossieSolicitante", fields: [solicitanteId], references: [id])
  revisor      Usuario?               @relation("dossieRevisor", fields: [revisorId], references: [id])
  execucoes    DossieExecucao[]
  /// Pedidos de promoção que levaram este dossiê anexado (RN20).
  solicitacoes AprovacaoSolicitacao[]

  @@index([empresaId])
  @@map("dossies")
}

/// Uma execução de geração (ficha §3.4 "registro de custo/execução"):
/// custo e duração são registrados por execução, inclusive nas tentativas
/// que falham — a telemetria de consumo precisa enxergar o gasto real.
model DossieExecucao {
  id             String    @id @default(cuid())
  dossieId       String    @map("dossie_id")
  /// Nome do provedor que executou (ex.: "anthropic", "manual").
  provedor       String
  /// Modelo usado, quando o provedor é automático.
  modelo         String?
  /// Sequencial por dossiê: 1 = geração original, 2+ = novas tentativas.
  tentativa      Int
  iniciadaEm     DateTime  @map("iniciada_em")
  concluidaEm    DateTime? @map("concluida_em")
  duracaoMs      Int?      @map("duracao_ms")
  tokensEntrada  Int?      @map("tokens_entrada")
  tokensSaida    Int?      @map("tokens_saida")
  /// Buscas na web realizadas pelo provedor automático, quando informado.
  buscasWeb      Int?      @map("buscas_web")
  /// Custo apurado a partir dos tokens e da tarifa configurada em ambiente.
  /// Nulo quando o provedor não tem custo (manual) ou não pôde ser apurado.
  custoBrl       Decimal?  @map("custo_brl") @db.Decimal(12, 4)
  sucesso        Boolean   @default(false)
  erro           String?
  versaoTemplate String    @map("versao_template")

  dossie Dossie @relation(fields: [dossieId], references: [id])

  @@unique([dossieId, tentativa])
  @@index([iniciadaEm])
  @@map("dossie_execucoes")
}

model EmpresaCategoria {
  empresaId   String @map("empresa_id")
  categoriaId String @map("categoria_id")

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@id([empresaId, categoriaId])
  @@map("empresa_categorias")
}

enum PapelContato {
  COMERCIAL
  TECNICO
  FINANCEIRO
}

model ContatoEmpresa {
  id           String       @id @default(cuid())
  empresaId    String       @map("empresa_id")
  papel        PapelContato
  nome         String
  cargo        String?
  email        String
  telefone     String?
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("contatos_empresa")
}

// ---------------------------------------------------------------------
// Bloco comercial — tabela própria (histórico de renovações)
// ---------------------------------------------------------------------

enum StatusContrato {
  VIGENTE
  DENUNCIADO
  ENCERRADO
}

enum AmbientePagamento {
  DENTRO_PLATAFORMA
  FORA_PLATAFORMA
  AMBOS
}

model ContratoComercial {
  id                   String            @id @default(cuid())
  empresaId            String            @map("empresa_id")
  /// Chave do anexo (PDF) no S3; metadados de assinatura eletrônica ao lado.
  anexoS3Key           String?           @map("anexo_s3_key")
  dataAssinatura       DateTime?         @map("data_assinatura") @db.Date
  hashVerificacao      String?           @map("hash_verificacao")
  /// Data-base da vigência; padrão contratual: 12 meses com renovação automática.
  vigenciaBase         DateTime          @map("vigencia_base") @db.Date
  status               StatusContrato    @default(VIGENTE)
  /// Comissão % sobre o valor efetivamente pago (por aliado, fonte = contrato).
  /// Incide apenas sobre Benefícios pagos; Recompensas não geram comissão.
  comissaoPct          Decimal?          @map("comissao_pct") @db.Decimal(5, 2)
  ambientesPagamento   AmbientePagamento @map("ambientes_pagamento")
  /// Marcada pelo job diário quando faltam ≤30 dias para o aniversário
  /// contratual (janela de não-renovação); alertada em T1/T2.
  emJanelaNaoRenovacao Boolean           @default(false) @map("em_janela_nao_renovacao")
  criadoEm             DateTime          @default(now()) @map("criado_em")
  atualizadoEm         DateTime          @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("contratos_comerciais")
}

// ---------------------------------------------------------------------
// Solução — ficha §3.2
// ---------------------------------------------------------------------

enum StatusSolucao {
  ATIVA
  INATIVA
}

enum PorteProdutor {
  PEQUENO
  MEDIO
  GRANDE
}

model Solucao {
  id                String          @id @default(cuid())
  /// Somente empresas em estágio ALIADA_ATIVA (RN01, garantida em serviço).
  empresaId         String          @map("empresa_id")
  nome              String
  /// Texto do card (~140c); obrigatória para publicar oferta (RN09).
  descricaoCurta    String?         @map("descricao_curta")
  descricaoCompleta String?         @map("descricao_completa")
  categoriaId       String?         @map("categoria_id")
  /// Perfil de cliente-alvo (lista fixa na ficha; alimenta recomendação e cestas).
  perfilCliente     PorteProdutor[] @map("perfil_cliente")
  /// Tecnologia/diferenciais como tags (vocabulário herdado do scouting).
  tecnologias       String[]
  imagemCardUrl     String?         @map("imagem_card_url")
  linkExterno       String?         @map("link_externo")
  status            StatusSolucao   @default(ATIVA)
  /// Cobertura: "nacional" OU conjunto de UFs (join solucao_ufs).
  coberturaNacional Boolean         @default(false) @map("cobertura_nacional")
  criadoEm          DateTime        @default(now()) @map("criado_em")
  atualizadoEm      DateTime        @updatedAt @map("atualizado_em")

  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  categoria          Categoria?         @relation(fields: [categoriaId], references: [id])
  culturas           SolucaoCultura[]
  ufs                SolucaoUf[]
  ofertas            Oferta[]
  ofertasPretendidas OfertaPretendida[]

  @@index([empresaId])
  @@map("solucoes")
}

model SolucaoCultura {
  solucaoId String @map("solucao_id")
  culturaId String @map("cultura_id")

  solucao Solucao @relation(fields: [solucaoId], references: [id])
  cultura Cultura @relation(fields: [culturaId], references: [id])

  @@id([solucaoId, culturaId])
  @@map("solucao_culturas")
}

model SolucaoUf {
  solucaoId String @map("solucao_id")
  ufId      String @map("uf_id")

  solucao Solucao @relation(fields: [solucaoId], references: [id])
  uf      Uf      @relation(fields: [ufId], references: [id])

  @@id([solucaoId, ufId])
  @@map("solucao_ufs")
}

// ---------------------------------------------------------------------
// Oferta — ficha §3.3 (natureza com TRÊS valores, decisão de 24/07)
// ---------------------------------------------------------------------

enum NaturezaOferta {
  RECOMPENSA
  BENEFICIO
  CUPOM_DESCONTO
}

enum ModalidadePagamento {
  UNICA
  RECORRENTE
}

enum StatusOferta {
  RASCUNHO
  PUBLICADA
  PAUSADA
  ENCERRADA
  EXPIRADA
}

model Oferta {
  id                   String               @id @default(cuid())
  solucaoId            String               @map("solucao_id")
  titulo               String
  /// Recompensa ⇒ preços zero; Cupom ⇒ desconto definido + código/regras.
  /// A comissão do cupom está [A CONFIRMAR]: ver COMISSAO_CUPOM em
  /// dominio/ofertas/constantes.ts — nenhum cálculo de receita para cupom.
  natureza             NaturezaOferta
  tipoBeneficioId      String               @map("tipo_beneficio_id")
  precoDe              Decimal?             @map("preco_de") @db.Decimal(12, 2)
  precoPor             Decimal?             @map("preco_por") @db.Decimal(12, 2)
  /// Somente quando natureza = CUPOM_DESCONTO.
  cupomCodigoRegras    String?              @map("cupom_codigo_regras")
  /// Somente Benefícios; recorrente para prestação continuada.
  modalidadePagamento  ModalidadePagamento? @map("modalidade_pagamento")
  /// Compatibilidade mecânica × ambiente habilitado do aliado (RN11, em serviço).
  mecanicaId           String               @map("mecanica_id")
  urlResgateExterno    String?              @map("url_resgate_externo")
  /// Fluxo operacional quando o resgate não é automático (recomendado
  /// para checkout externo).
  instrucoesResgate    String?              @map("instrucoes_resgate")
  /// Onda 4 (ficha §3, extensão retroativa): onde a oferta vive. A vitrine
  /// é uma só e a publicação Minutrade segue inalterada — o vínculo serve
  /// à gestão e à medição. Quando destinada a campanha, a vigência dela é
  /// SUGERIDA na T5 (editável), nunca imposta.
  destinacao           DestinacaoOferta     @default(VITRINE)
  destinacaoCampanhaId String?              @map("destinacao_campanha_id")
  destinacaoCestaId    String?              @map("destinacao_cesta_id")
  vigenciaInicio       DateTime             @map("vigencia_inicio") @db.Date
  /// Fim vazio = prazo indeterminado; fim < hoje ⇒ EXPIRADA (RN03, job diário).
  vigenciaFim          DateTime?            @map("vigencia_fim") @db.Date
  /// [A CONFIRMAR] se a Minutrade suporta limite; até lá o campo é interno
  /// (alerta ao atingir), sem efeito na publicação.
  limiteResgates       Int?                 @map("limite_resgates")
  status               StatusOferta         @default(RASCUNHO)
  /// Ligada quando oferta publicada é alterada após o último export (RN10);
  /// o export seguinte a limpa.
  pendenteRepublicacao Boolean              @default(false) @map("pendente_republicacao")
  idExternoMinutrade   String?              @map("id_externo_minutrade")
  criadoEm             DateTime             @default(now()) @map("criado_em")
  atualizadoEm         DateTime             @updatedAt @map("atualizado_em")

  solucao            Solucao                      @relation(fields: [solucaoId], references: [id])
  tipoBeneficio      TipoBeneficio                @relation(fields: [tipoBeneficioId], references: [id])
  mecanica           Mecanica                     @relation(fields: [mecanicaId], references: [id])
  telemetriaEventos  TelemetriaEvento[]
  acumuladosIniciais TelemetriaAcumuladoInicial[]

  destinacaoCampanha Campanha?          @relation("ofertasDestinadas", fields: [destinacaoCampanhaId], references: [id])
  destinacaoCesta    Cesta?             @relation("ofertasDestinadas", fields: [destinacaoCestaId], references: [id])
  cestas             CestaOferta[]
  campanhasAvulsas   CampanhaOferta[]
  ofertaPretendida   OfertaPretendida[]

  @@index([solucaoId])
  @@index([status])
  @@index([destinacaoCampanhaId])
  @@index([destinacaoCestaId])
  @@map("ofertas")
}

// ---------------------------------------------------------------------
// Telemetria — fatos imutáveis (RN07)
// ---------------------------------------------------------------------

enum TipoEventoTelemetria {
  EMISSAO_VOUCHER
  RESGATE_VOUCHER
  COMPRA_CONFIRMADA
}

model TelemetriaEvento {
  id              String               @id @default(cuid())
  idVoucher       String               @map("id_voucher")
  tipo            TipoEventoTelemetria
  /// Na Onda 1 o CPF entra apenas como hash (dado pessoal pleno só na
  /// Onda 5, com RBAC de PF).
  cpfHash         String?              @map("cpf_hash")
  valor           Decimal?             @db.Decimal(12, 2)
  dataEvento      DateTime             @map("data_evento")
  canal           String?
  /// Identificadores externos crus do arquivo, para rastreabilidade mesmo
  /// quando a resolução para oferta/empresa falha (quarentena, F4).
  idSellerExterno String?              @map("id_seller_externo")
  idOfertaExterno String?              @map("id_oferta_externo")
  ofertaId        String?              @map("oferta_id")
  arquivoOrigem   String?              @map("arquivo_origem")
  importacaoId    String?              @map("importacao_id")
  criadoEm        DateTime             @default(now()) @map("criado_em")

  oferta     Oferta?     @relation(fields: [ofertaId], references: [id])
  importacao Importacao? @relation(fields: [importacaoId], references: [id])

  /// Idempotência de reimportação.
  @@unique([idVoucher, tipo])
  @@index([ofertaId])
  @@map("telemetria_eventos")
}

/// Carga única da telemetria histórica ("acumulado até a data da carga",
/// ficha §7). O rótulo de "Resgates" está [A CONFIRMAR] (emissão × resgate
/// efetivo) — os números são armazenados sem interpretação.
model TelemetriaAcumuladoInicial {
  id           String   @id @default(cuid())
  ofertaId     String   @map("oferta_id")
  resgates     Int?
  compras      Int?
  dataCorte    DateTime @map("data_corte") @db.Date
  importacaoId String?  @map("importacao_id")
  criadoEm     DateTime @default(now()) @map("criado_em")

  oferta     Oferta      @relation(fields: [ofertaId], references: [id])
  importacao Importacao? @relation(fields: [importacaoId], references: [id])

  @@unique([ofertaId, dataCorte])
  @@map("telemetria_acumulados_iniciais")
}

// ---------------------------------------------------------------------
// Publicação (export batch) e importações
// ---------------------------------------------------------------------

model Publicacao {
  id       String   @id @default(cuid())
  autorId  String   @map("autor_id")
  /// Pacote gerado pelo ExportAdapter em uso (layout Minutrade [A CONFIRMAR];
  /// até lá, GenericJsonCsvAdapter).
  adapter  String
  pacote   Json
  /// Diff em relação à publicação anterior (RN10).
  diff     Json?
  criadoEm DateTime @default(now()) @map("criado_em")

  autor Usuario @relation(fields: [autorId], references: [id])

  @@map("publicacoes")
}

enum TipoImportacao {
  TELEMETRIA
  CARGA_SELLERS
  CARGA_OFERTAS
  /// Onda 2 (T9): importação de listas de prospects para o radar.
  CARGA_PROSPECTS
  /// Onda 5 — as duas famílias da importação de assinantes (ficha §3).
  ASSINANTES_NUCLEO
  ASSINANTES_ENRIQUECIMENTO
}

/// Política de carga de assinantes (RN29): a carga declara o que a
/// ausência de um CPF significa. Só FOTO_COMPLETA marca ausentes como
/// "fora da base", e somente com confirmação explícita em duas etapas.
enum PoliticaImportacao {
  INCREMENTAL
  FOTO_COMPLETA
}

model Importacao {
  id                     String              @id @default(cuid())
  tipo                   TipoImportacao
  nomeArquivo            String              @map("nome_arquivo")
  linhasOk               Int                 @default(0) @map("linhas_ok")
  linhasErro             Int                 @default(0) @map("linhas_erro")
  /// Linhas rejeitadas com motivo (relatório pós-carga).
  relatorioQuarentena    Json?               @map("relatorio_quarentena")
  /// T9 (Onda 2): mapeamento de colunas escolhido no passo 2 — o layout
  /// real das listas de prospects é [A CONFIRMAR] e vive como
  /// configuração por importação, nunca como código rígido.
  configuracaoMapeamento Json?               @map("configuracao_mapeamento")
  /// Onda 5 — política declarada da carga de assinantes (RN29);
  /// null nos tipos das Ondas 1 e 2, que não têm essa semântica.
  politica               PoliticaImportacao?
  /// Onda 5 — de/para de colunas aplicado pelo mapeador da T20
  /// (o dicionário real do arquivo do comprador é [A CONFIRMAR]).
  mapeamentoColunas      Json?               @map("mapeamento_colunas")
  /// Onda 5 — resumo da carga (novos, atualizados, fora da base,
  /// divergências de enriquecimento), exibido na T20 e no histórico.
  resumo                 Json?
  autorId                String              @map("autor_id")
  criadoEm               DateTime            @default(now()) @map("criado_em")

  autor               Usuario                      @relation(fields: [autorId], references: [id])
  telemetriaEventos   TelemetriaEvento[]
  acumuladosIniciais  TelemetriaAcumuladoInicial[]
  stagingSellers      StagingSeller[]
  stagingOfertas      StagingOferta[]
  stagingAgrupamentos StagingAgrupamento[]
  stagingEmpresas     StagingEmpresa[]
  stagingAssinantes   StagingAssinante[]
  atributosGravados   AtributoEnriquecimento[]

  @@map("importacoes")
}

// ---------------------------------------------------------------------
// Staging da carga inicial (tela de conferência antes da efetivação)
// ---------------------------------------------------------------------

enum EstadoStaging {
  PENDENTE
  APROVADA
  REJEITADA
  EFETIVADA
}

model StagingSeller {
  id                 String        @id @default(cuid())
  importacaoId       String        @map("importacao_id")
  linhaOrigem        Int           @map("linha_origem")
  /// Linha crua da planilha (tolerante a colunas futuras — dump Minutrade
  /// [A CONFIRMAR] enriquece o staging antes da conferência).
  dadosOriginais     Json          @map("dados_originais")
  // Campos mapeados da Lista de Sellers (ficha §7)
  nomeSeller         String?       @map("nome_seller")
  idSellerExterno    String?       @map("id_seller_externo")
  dataEntrada        DateTime?     @map("data_entrada") @db.Date
  estado             EstadoStaging @default(PENDENTE)
  mensagemErro       String?       @map("mensagem_erro")
  empresaIdEfetivada String?       @map("empresa_id_efetivada")
  criadoEm           DateTime      @default(now()) @map("criado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")

  importacao Importacao @relation(fields: [importacaoId], references: [id])

  @@index([importacaoId])
  @@map("staging_sellers")
}

model StagingOferta {
  id                 String        @id @default(cuid())
  importacaoId       String        @map("importacao_id")
  linhaOrigem        Int           @map("linha_origem")
  dadosOriginais     Json          @map("dados_originais")
  // Campos mapeados da Lista de Ofertas (ficha §7)
  produto            String? // → nome da solução e título da oferta
  checkout           String? // → mecânica + natureza
  preco              String?
  desconto           String?
  precoFinal         String?       @map("preco_final")
  statusOferta       String?       @map("status_oferta")
  resgates           Int?
  compras            Int?
  idSellerExterno    String?       @map("id_seller_externo")
  agrupamentoId      String?       @map("agrupamento_id")
  estado             EstadoStaging @default(PENDENTE)
  mensagemErro       String?       @map("mensagem_erro")
  solucaoIdEfetivada String?       @map("solucao_id_efetivada")
  ofertaIdEfetivada  String?       @map("oferta_id_efetivada")
  criadoEm           DateTime      @default(now()) @map("criado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")

  importacao  Importacao          @relation(fields: [importacaoId], references: [id])
  agrupamento StagingAgrupamento? @relation(fields: [agrupamentoId], references: [id])

  @@index([importacaoId])
  @@map("staging_ofertas")
}

/// Staging da importação de prospects (T9, Onda 2): linha crua + campos
/// extraídos pelo mapeamento de colunas configurado na importação. A
/// deduplicação por CNPJ/nome (contra o radar e as aliadas) marca a linha
/// antes do resumo; a efetivação cria Empresas MAPEADA.
model StagingEmpresa {
  id                   String        @id @default(cuid())
  importacaoId         String        @map("importacao_id")
  linhaOrigem          Int           @map("linha_origem")
  dadosOriginais       Json          @map("dados_originais")
  // Campos extraídos conforme a configuração de mapeamento
  nomeFantasia         String?       @map("nome_fantasia")
  site                 String?
  cnpj                 String?
  categoriasTexto      String?       @map("categorias_texto")
  /// Preenchido quando a deduplicação encontra a empresa já cadastrada.
  duplicataDeEmpresaId String?       @map("duplicata_de_empresa_id")
  estado               EstadoStaging @default(PENDENTE)
  mensagemErro         String?       @map("mensagem_erro")
  empresaIdEfetivada   String?       @map("empresa_id_efetivada")
  criadoEm             DateTime      @default(now()) @map("criado_em")
  atualizadoEm         DateTime      @updatedAt @map("atualizado_em")

  importacao Importacao @relation(fields: [importacaoId], references: [id])

  @@index([importacaoId])
  @@map("staging_empresas")
}

/// Agrupamentos produto→solução propostos pela heurística
/// "mesmo seller + mesmo texto de produto", revisáveis na conferência.
model StagingAgrupamento {
  id                  String        @id @default(cuid())
  importacaoId        String        @map("importacao_id")
  chaveHeuristica     String        @map("chave_heuristica")
  nomeSolucaoProposto String        @map("nome_solucao_proposto")
  estado              EstadoStaging @default(PENDENTE)
  criadoEm            DateTime      @default(now()) @map("criado_em")
  atualizadoEm        DateTime      @updatedAt @map("atualizado_em")

  importacao Importacao      @relation(fields: [importacaoId], references: [id])
  ofertas    StagingOferta[]

  @@index([importacaoId])
  @@map("staging_agrupamentos")
}

// ---------------------------------------------------------------------
// Motor de aprovação (RN06)
// ---------------------------------------------------------------------

enum TipoEntidadeAprovacao {
  PROMOCAO_ALIADA_ATIVA
  PUBLICACAO_OFERTA
  /// RN27 (Onda 3) — família sensível do Parametrizador: comissão-padrão,
  /// pesos de indicadores, tetos do dossiê e metas. Nasce DESLIGADA; ligar
  /// na T7 passa a exigir aprovação dessas escritas sem código novo.
  PARAMETRO_SENSIVEL
  /// Onda 4 (ficha §2): porta de aprovação da ativação de campanha —
  /// ligável na T7, nasce DESLIGADA.
  ATIVACAO_CAMPANHA
}

/// Regra por tipo de entidade: ligável/desligável em T7 sem código.
/// Nasce com PROMOCAO_ALIADA_ATIVA ligada e PUBLICACAO_OFERTA desligada.
model AprovacaoRegra {
  id           String                @id @default(cuid())
  tipoEntidade TipoEntidadeAprovacao @unique @map("tipo_entidade")
  exigida      Boolean
  atualizadoEm DateTime              @updatedAt @map("atualizado_em")

  aprovadores AprovacaoRegraAprovador[]

  @@map("aprovacao_regras")
}

model AprovacaoRegraAprovador {
  regraId   String @map("regra_id")
  usuarioId String @map("usuario_id")

  regra   AprovacaoRegra @relation(fields: [regraId], references: [id])
  usuario Usuario        @relation(fields: [usuarioId], references: [id])

  @@id([regraId, usuarioId])
  @@map("aprovacao_regra_aprovadores")
}

enum EstadoSolicitacao {
  SOLICITADA
  APROVADA
  DEVOLVIDA
}

model AprovacaoSolicitacao {
  id                 String                @id @default(cuid())
  tipoEntidade       TipoEntidadeAprovacao @map("tipo_entidade")
  entidadeId         String                @map("entidade_id")
  solicitanteId      String                @map("solicitante_id")
  estado             EstadoSolicitacao     @default(SOLICITADA)
  /// Obrigatório na devolução (validado em serviço).
  comentario         String?
  /// Onda 3 (RN27) — conteúdo da mudança que aguarda decisão. As entidades
  /// das Ondas 1 e 2 já existem no banco quando entram na fila (promover
  /// uma empresa, publicar uma oferta), então `entidadeId` bastava. Uma
  /// escrita de parâmetro, não: o valor proposto NÃO pode tocar
  /// `valores_regra` antes de aprovado — a configuração vigente continua
  /// valendo —, e é aqui que ele espera.
  payload            Json?
  /// Segregação RN06 (solicitante ≠ aprovador) garantida em serviço.
  aprovadorId        String?               @map("aprovador_id")
  decididoEm         DateTime?             @map("decidido_em")
  criadoEm           DateTime              @default(now()) @map("criado_em")
  // --- RN20 (Onda 2, F9): o caso completo viaja com o pedido ---
  /// Avaliação de scout VIGENTE no momento do pedido (a fechada de maior
  /// versão). Fixada aqui, e não consultada na hora de decidir, para que o
  /// aprovador veja o que existia quando o pedido foi feito — avaliações
  /// são imutáveis após fechamento (RN18), mas uma nova versão pode ser
  /// aberta enquanto o pedido espera na fila.
  avaliacaoVigenteId String?               @map("avaliacao_vigente_id")
  /// Dossiê vigente no momento do pedido (o mais recente da empresa).
  /// Pode ser nulo: o dossiê é insumo de decisão, não pré-requisito de
  /// promoção — a T6 diz ao aprovador quando não há.
  dossieVigenteId    String?               @map("dossie_vigente_id")

  solicitante      Usuario         @relation("solicitante", fields: [solicitanteId], references: [id])
  aprovador        Usuario?        @relation("aprovador", fields: [aprovadorId], references: [id])
  avaliacaoVigente AvaliacaoScout? @relation(fields: [avaliacaoVigenteId], references: [id])
  dossieVigente    Dossie?         @relation(fields: [dossieVigenteId], references: [id])

  @@index([estado])
  @@index([tipoEntidade, entidadeId])
  @@map("aprovacao_solicitacoes")
}

// ---------------------------------------------------------------------
// Auditoria — toda mutação de entidade de negócio (serviço, não trigger)
// ---------------------------------------------------------------------

model AuditoriaEvento {
  id            String   @id @default(cuid())
  /// Nome lógico da entidade (ex.: "empresa", "oferta").
  entidade      String
  entidadeId    String   @map("entidade_id")
  campo         String
  /// Valores serializados em JSON (null = campo ausente/limpo).
  valorAnterior String?  @map("valor_anterior")
  valorNovo     String?  @map("valor_novo")
  autorId       String   @map("autor_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  autor Usuario @relation(fields: [autorId], references: [id])

  @@index([entidade, entidadeId])
  @@index([autorId])
  @@map("auditoria_eventos")
}

// ---------------------------------------------------------------------
// Assinantes (Onda 5 antecipada, F11) — ficha-onda5-assinantes.md
// ---------------------------------------------------------------------

/// Preferência do núcleo importado (ficha §1.1a — os seis campos
/// confirmados do arquivo do comprador).
enum PreferenciaAssinante {
  AGRICULTURA
  PECUARIA
  AMBOS
}

/// FORA_DA_BASE é marcado exclusivamente por carga "foto completa"
/// confirmada em duas etapas (RN29) — nunca por omissão.
enum StatusBaseAssinante {
  ATIVO
  FORA_DA_BASE
}

model Assinante {
  id             String                @id @default(cuid())
  /// Identidade única e chave de junção com telemetria_eventos.cpf_hash
  /// (RN36): HMAC-SHA-256 do CPF normalizado, com chave própria via env
  /// CPF_HASH_KEY (determinístico entre cargas).
  cpfHash        String                @unique @map("cpf_hash")
  /// CPF cifrado em repouso (AES-256-GCM com APP_ENCRYPTION_KEY via env —
  /// a chave nunca entra no repositório). Toda exibição nasce mascarada;
  /// a plena é decidida na API, com permissão e auditoria (RN30).
  cpfCifrado     String                @map("cpf_cifrado")
  nome           String
  /// Endereço bruto como veio do arquivo (dicionário [A CONFIRMAR]).
  enderecoBruto  String?               @map("endereco_bruto")
  /// CEP quando o arquivo trouxer ([A CONFIRMAR] — ficha §10).
  cep            String?
  /// Derivados na importação (RN32); null = estado honesto "não derivado".
  uf             String?
  municipio      String?
  email          String?
  telefone       String?
  preferencia    PreferenciaAssinante?
  statusBase     StatusBaseAssinante   @default(ATIVO) @map("status_base")
  /// Marca de registro sintético (regra do CLAUDE.md): fixtures e seeds de
  /// PF são gerados e marcados — a UI exibe "registro ilustrativo".
  marcaSintetico Boolean               @default(false) @map("marca_sintetico")
  criadoEm       DateTime              @default(now()) @map("criado_em")
  atualizadoEm   DateTime              @updatedAt @map("atualizado_em")

  assinatura Assinatura?
  atributos  AtributoEnriquecimento[]

  // Índices do catálogo de segmentação — contagem viva em milissegundos
  // no volume de projeto (ficha §7).
  @@index([uf])
  @@index([municipio])
  @@index([preferencia])
  @@index([statusBase])
  @@map("assinantes")
}

/// Plano da assinatura ("mensal/anual", ficha §1.1d).
enum PlanoAssinatura {
  MENSAL
  ANUAL
}

/// Assinatura/vencimento — a ORIGEM do dado é [A CONFIRMAR: arquivo do
/// comprador × extrato Minutrade] (ficha §1.1d e §10). A seção existe no
/// modelo e no perfil, sinalizada como "origem pendente"; nada é suposto.
model Assinatura {
  id           String           @id @default(cuid())
  assinanteId  String           @unique @map("assinante_id")
  plano        PlanoAssinatura?
  /// Valores possíveis [A CONFIRMAR] — armazenado como recebido da fonte.
  status       String?
  /// Vencimento é visibilidade e filtro 30/60/90 (RN37); nenhuma ação.
  vencimento   DateTime?        @db.Date
  /// Fonte real deste registro quando definida ([A CONFIRMAR]);
  /// null = origem do dado ainda em definição (exibido na T19).
  origemDado   String?          @map("origem_dado")
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")

  assinante Assinante @relation(fields: [assinanteId], references: [id])

  @@index([vencimento])
  @@map("assinaturas")
}

/// Catálogo de atributos de enriquecimento (EAV leve com catálogo).
/// É a allowlist dinâmica do construtor de segmentos (RN33): um campo de
/// enriquecimento só filtra se existir aqui e estiver ativo. Trade-off
/// documentado (prompt da Onda 5): enquanto os atributos não estabilizam
/// ([A CONFIRMAR], ficha §10), EAV dá flexibilidade; quando estabilizarem,
/// promover os quentes a colunas indexadas.
model CatalogoAtributo {
  id       String   @id @default(cuid())
  slug     String   @unique
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  valores AtributoEnriquecimento[]

  @@map("catalogo_atributos")
}

/// Valor de atributo por assinante, com proveniência obrigatória (RN35).
/// Multivalorado por desenho: um assinante pode ter várias unidades
/// produtivas, cada uma com cultura própria (protótipo v6.1, T18/T19).
/// Enriquecimento nunca sobrescreve o núcleo — divergências são
/// registradas no resumo da carga.
model AtributoEnriquecimento {
  id             String   @id @default(cuid())
  assinanteId    String   @map("assinante_id")
  catalogoId     String   @map("catalogo_id")
  valor          String
  /// Proveniência (RN35): fonte declarada na carga + data de referência.
  fonte          String
  dataReferencia DateTime @map("data_referencia") @db.Date
  importacaoId   String?  @map("importacao_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  assinante  Assinante        @relation(fields: [assinanteId], references: [id])
  catalogo   CatalogoAtributo @relation(fields: [catalogoId], references: [id])
  importacao Importacao?      @relation(fields: [importacaoId], references: [id])

  // Índice de segmentação: EXISTS (catalogo, valor) por assinante.
  @@index([catalogoId, valor])
  @@index([assinanteId])
  @@map("atributos_enriquecimento")
}

/// Segmento salvo (RN33): SEMPRE a estrutura declarativa — lista ordenada
/// de regras { campo, operador, valor, combinadorAnterior } sobre o
/// catálogo. É a semente do público de campanha (Onda 4 reutiliza no
/// simulador de alcance sem código novo de filtro); guarda a regra,
/// não a lista — contagem recalculada a cada consulta.
model Segmento {
  id           String   @id @default(cuid())
  nome         String
  regras       Json
  autorId      String   @map("autor_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  autor       Usuario           @relation(fields: [autorId], references: [id])
  exportacoes ExportacaoLista[]
  campanhas   Campanha[]
  cestas      Cesta[]

  @@map("segmentos")
}

/// Exportação de lista de contato (RN34): snapshot materializado e
/// auditável — autor, data, contagem, FINALIDADE obrigatória, a regra que
/// gerou a lista e o hash do arquivo. O CSV vai ao armazenamento de
/// objetos (S3; adapter local em desenvolvimento/teste).
model ExportacaoLista {
  id           String   @id @default(cuid())
  autorId      String   @map("autor_id")
  finalidade   String
  contagem     Int
  /// Regra declarativa usada na geração (gravada junto, RN34).
  regras       Json
  segmentoId   String?  @map("segmento_id")
  arquivoChave String   @map("arquivo_chave")
  hashArquivo  String   @map("hash_arquivo")
  criadoEm     DateTime @default(now()) @map("criado_em")

  autor                        Usuario    @relation(fields: [autorId], references: [id])
  segmento                     Segmento?  @relation(fields: [segmentoId], references: [id])
  /// Onda 4: quando a finalidade é a ativação de uma campanha, este é o
  /// snapshot do público congelado (RN38 herdando RN34).
  campanhasComPublicoCongelado Campanha[]

  @@map("exportacoes_lista")
}

/// Staging da importação de assinantes (T20): o arquivo inteiro entra
/// aqui nos passos 1–4 (dry-run); nada muta o cadastro-mestre antes da
/// confirmação do passo 5 (RN29). Linhas inválidas ficam REJEITADA com
/// motivo (RN31 — quarentena, nunca tudo-ou-nada).
model StagingAssinante {
  id             String        @id @default(cuid())
  importacaoId   String        @map("importacao_id")
  linhaOrigem    Int           @map("linha_origem")
  /// Linha crua do arquivo, para rastreabilidade e download de erros.
  dadosOriginais Json          @map("dados_originais")
  /// Núcleo normalizado pelo mapeador OU pares atributo→valor da família
  /// de enriquecimento (conforme o tipo da importação).
  camposMapeados Json?         @map("campos_mapeados")
  cpfHash        String?       @map("cpf_hash")
  cpfCifrado     String?       @map("cpf_cifrado")
  estado         EstadoStaging @default(PENDENTE)
  mensagemErro   String?       @map("mensagem_erro")
  criadoEm       DateTime      @default(now()) @map("criado_em")

  importacao Importacao @relation(fields: [importacaoId], references: [id])

  @@index([importacaoId])
  @@index([importacaoId, cpfHash])
  @@map("staging_assinantes")
}

// ---------------------------------------------------------------------
// Metas de novos aliados (Onda 2, F9) — ficha §3.5 e RN22
// ---------------------------------------------------------------------

/// Períodos de meta (ficha da Onda 3 §3.2, que governa a edição na T17).
// Parametrizador — Onda 3 (ficha v0.2 §3, RN23–RN28)
//
// Três classes de parâmetro:
//  1. Listas de domínio  — já são tabelas desde a F1 (Categoria, Cultura,
//     Uf, TipoBeneficio, MotivoSuspensao, MotivoDescarte, Indicador); a
//     Onda 3 acrescenta apenas PerfilCliente e o CRUD sobre todas elas.
//  2. Valores de regra   — ValorRegra + ValorRegraHistorico. As metas
//     vivem em MetaPeriodo, criada pela F9 e editada aqui pela T17.
//  3. Somente leitura    — enums e metadados; não ganham tabela por
//     decisão de projeto (RN26: alterá-los é release, não configuração).
// ---------------------------------------------------------------------

/// Perfil de cliente — porte × natureza (PF/PJ), ficha §3.1. NASCE VAZIA:
/// o seed depende de definição do negócio (protótipo v6.1, família
/// "perfil": "seed a definir com o negócio"). Ausência de dado é estado
/// pendente, jamais um valor plausível — a T16 mostra o estado vazio com a
/// explicação e o Administrador cria os itens quando o negócio fechar.
/// Não se confunde com Solucao.perfilCliente (enum PorteProdutor da Onda
/// 1, que é o recorte de porte do produtor-alvo da solução).
model PerfilCliente {
  id    String  @id @default(cuid())
  slug  String  @unique
  nome  String  @unique
  ordem Int
  ativo Boolean @default(true)

  @@map("perfis_cliente")
}

/// Natureza do valor — governa formatação, unidade e validação na T17.
enum TipoValorRegra {
  DIAS
  MESES
  PERCENTUAL
  MONETARIO
}

/// Valor de regra configurável (ficha §3.2). Substitui as constantes das
/// Ondas 1 e 2: quem lê é o Serviço de Configuração, nunca o código de
/// tela. RN25 — toda escrita é prospectiva e deixa rastro em
/// ValorRegraHistorico; registro fechado jamais é recalculado.
model ValorRegra {
  id           String         @id @default(cuid())
  /// Chave estável referenciada pelo código (ex.: FUNIL_ENVELHECIMENTO_LEVE_DIAS).
  chave        String         @unique
  /// Agrupamento visual da T17: REGUAS · COMISSAO · TETOS_DOSSIE.
  grupo        String
  rotulo       String
  /// "Onde isto aparece" — texto da T17, não comentário de código.
  descricao    String
  tipo         TipoValorRegra
  /// NULL = nunca definido. É o caso dos tetos do dossiê, cuja definição
  /// segue [A CONFIRMAR TI] na ficha §8: a UI mostra o campo vazio com a
  /// etiqueta de pendência em vez de um número inventado.
  valor        Decimal?       @db.Decimal(14, 4)
  /// RN27 — pertence à família sensível (comissão-padrão, tetos). Quando a
  /// regra PARAMETRO_SENSIVEL estiver ligada na T7, a escrita passa a
  /// exigir aprovação sem código novo.
  sensivel     Boolean        @default(false)
  ordem        Int
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  historico ValorRegraHistorico[]

  @@index([grupo])
  @@map("valores_regra")
}

/// Histórico por valor (RN25): "alterado por X em D, de A para B". É o que
/// a T17 exibe sob cada linha; complementa — não substitui — o evento de
/// auditoria, que continua sendo gravado pelo serviço existente.
model ValorRegraHistorico {
  id            String   @id @default(cuid())
  valorRegraId  String   @map("valor_regra_id")
  valorAnterior Decimal? @map("valor_anterior") @db.Decimal(14, 4)
  valorNovo     Decimal? @map("valor_novo") @db.Decimal(14, 4)
  autorId       String   @map("autor_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  valorRegra ValorRegra @relation(fields: [valorRegraId], references: [id])
  autor      Usuario    @relation(fields: [autorId], references: [id])

  @@index([valorRegraId, criadoEm])
  @@map("valores_regra_historico")
}

/// Snapshot dos parâmetros que afetam o score (indicadores, dimensões e
/// pesos) no momento em que valiam (RN25). Nova escrita em indicadores ou
/// pesos gera uma nova versão; as avaliações já fechadas continuam
/// apontando para a sua, e é isso que prova o efeito prospectivo.
model ConfiguracaoVersao {
  id       String   @id @default(cuid())
  /// Sequencial legível (1 = versão-seed criada pela migration).
  numero   Int      @unique
  /// [{indicadorId, slug, nome, grupo, dimensao, peso, ativo}] — congelado.
  snapshot Json
  /// O que provocou a versão (ex.: "carga inicial", "peso de indicador").
  motivo   String
  /// NULL na versão-seed: nasceu da migration, não de um autor humano.
  autorId  String?  @map("autor_id")
  criadoEm DateTime @default(now()) @map("criado_em")

  autor      Usuario?         @relation(fields: [autorId], references: [id])
  avaliacoes AvaliacaoScout[]

  @@map("configuracao_versoes")
}

/// Períodos de meta da ficha §3.2. Cada período é alinhado ao calendário
/// (mês, trimestre ou ano civil), o que torna a não-sobreposição da RN28
/// verificável tanto no domínio quanto no banco.
enum PeriodoMeta {
  MENSAL
  TRIMESTRAL
  ANUAL
}

/// Meta de novos aliados por período (ficha Onda 2 §3.5). A F9 apenas LÊ
/// esta tabela — a T14 exibe meta × realizado (RN22) e o valor nasce do
/// seed com a decisão de negócio registrada. A escrita chega no
/// Parametrizador (Onda 3, T17), restrita ao Administrador da Plataforma;
/// a tabela já nasce no formato que aquele editor espera, inclusive a
/// unicidade da RN28 (uma meta geral por período; uma por categoria por
/// período), garantida por índices parciais na migration.
model MetaPeriodo {
  id           String      @id @default(cuid())
  periodo      PeriodoMeta
  /// Janela do período: início inclusivo, fim exclusivo (primeiro instante
  /// do período seguinte) — o mesmo recorte usado para contar o realizado.
  inicio       DateTime    @db.Date
  fim          DateTime    @db.Date
  /// Nulo = meta geral; preenchida = meta por categoria (RN28).
  categoriaId  String?     @map("categoria_id")
  /// Novos aliados esperados no período.
  valor        Int
  /// De onde veio o número (ex.: decisão de negócio de 24/07) — nenhum
  /// valor de meta nasce sem procedência.
  origem       String
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  categoria Categoria? @relation(fields: [categoriaId], references: [id])

  @@index([inicio, fim])
  @@map("metas_periodo")
}

// ---------------------------------------------------------------------
// Ficha Cadastral do Aliado v1 — seções D e F do M1 (Onda 2, F9)
// docs/especificacao/ficha-cadastral-aliado-v1.md
// ---------------------------------------------------------------------

/// Natureza do público-alvo (seção B): pessoa física, jurídica ou ambas.
enum NaturezaPublico {
  PF
  PJ
  AMBAS
}

/// Seção D — indicadores DECLARADOS pelo aliado na negociação. O grau de
/// confiança é distinto do apurado em pesquisa: são autodeclarados, e a
/// data da declaração é parte do dado. Destino: aba Scouting da ficha —
/// nunca o card público, e nunca nota de indicador (RN19 vale igual).
model IndicadorDeclarado {
  id              String   @id @default(cuid())
  empresaId       String   @map("empresa_id")
  /// Quando o aliado declarou — sem isso o número não se interpreta.
  dataDeclaracao  DateTime @map("data_declaracao") @db.Date
  ticketMedio     Decimal? @map("ticket_medio") @db.Decimal(12, 2)
  /// -100 a 100 (escala do NPS).
  nps             Int?
  churnMensalPct  Decimal? @map("churn_mensal_pct") @db.Decimal(5, 2)
  numeroClientes  Int?     @map("numero_clientes")
  anoFundacao     Int?     @map("ano_fundacao")
  /// Quem registrou a declaração na plataforma (o analista, não o aliado).
  registradoPorId String   @map("registrado_por_id")
  criadoEm        DateTime @default(now()) @map("criado_em")

  empresa       Empresa @relation(fields: [empresaId], references: [id])
  registradoPor Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([empresaId])
  @@map("indicadores_declarados")
}

enum StatusOfertaPretendida {
  RASCUNHO
  CONVERTIDA
}

/// Seção F — oferta pretendida, já estruturada nos campos mínimos do
/// modelo de Oferta. Ao promover a empresa a Aliada ativa, cada linha
/// vira um rascunho de Solução + Oferta pendente de curadoria: zero
/// redigitação, completude visível.
model OfertaPretendida {
  id                String                 @id @default(cuid())
  empresaId         String                 @map("empresa_id")
  natureza          NaturezaOferta
  titulo            String
  descricao         String?
  tipoBeneficioId   String?                @map("tipo_beneficio_id")
  mecanicaId        String?                @map("mecanica_id")
  /// Valores pretendidos; Recompensa é gratuidade e mantém ambos vazios
  /// (validado em domínio, mesma regra da oferta real).
  precoDe           Decimal?               @map("preco_de") @db.Decimal(12, 2)
  precoPor          Decimal?               @map("preco_por") @db.Decimal(12, 2)
  /// Texto operacional do pós-voucher (URL ou fluxo de contato/lead) — a
  /// lacuna que o documento em Word não capturava.
  instrucoesResgate String?                @map("instrucoes_resgate")
  vigenciaInicio    DateTime?              @map("vigencia_inicio") @db.Date
  vigenciaFim       DateTime?              @map("vigencia_fim") @db.Date
  status            StatusOfertaPretendida @default(RASCUNHO)
  /// Preenchidos quando a promoção converte a linha em rascunho real.
  solucaoId         String?                @map("solucao_id")
  ofertaId          String?                @map("oferta_id")
  criadoEm          DateTime               @default(now()) @map("criado_em")
  atualizadoEm      DateTime               @updatedAt @map("atualizado_em")

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  tipoBeneficio TipoBeneficio? @relation(fields: [tipoBeneficioId], references: [id])
  mecanica      Mecanica?      @relation(fields: [mecanicaId], references: [id])
  solucao       Solucao?       @relation(fields: [solucaoId], references: [id])
  oferta        Oferta?        @relation(fields: [ofertaId], references: [id])

  @@index([empresaId])
  @@map("ofertas_pretendidas")
}

// ---------------------------------------------------------------------
// Campanhas e Cestas (Onda 4, F12) — ficha-onda4-campanhas-cestas.md
//
// Modelo operacional (ficha §1.1): a Broto modela e ativa; a MINUTRADE
// executa o disparo a partir do kit. Nenhum caminho de disparo existe
// nesta plataforma (RN39) — o que sai daqui é o pacote versionado.
// ---------------------------------------------------------------------

/// Destinação da oferta (ficha §3, extensão retroativa da Onda 1).
enum DestinacaoOferta {
  VITRINE
  CAMPANHA
  CESTA
}

/// Ciclo de vida da campanha (ficha §3). A porta de aprovação entre
/// Rascunho e Ativa é ligável na T7 (ATIVACAO_CAMPANHA, nasce desligada).
enum EstadoCampanha {
  RASCUNHO
  ATIVA
  ENCERRADA
}

/// Origem do público da campanha: segmento salvo da carteira (Onda 5) ou
/// regras montadas na própria campanha. Em ambos os casos o que fica
/// gravado é a REGRA declarativa — a lista só se materializa na ativação.
enum OrigemPublicoCampanha {
  SEGMENTO_SALVO
  REGRAS_PROPRIAS
}

/// Tipos de meta (ficha §3): múltiplas e opcionais por campanha.
enum TipoMetaCampanha {
  RESGATES
  CONVERSAO_PCT
  ALIADOS_PARTICIPANTES
  OFERTAS_ATIVAS
}

/// Nível de atribuição da medição (RN43) — gravado em cada número, nunca
/// inferido na leitura. POR_PUBLICO depende da telemetria por CPF
/// [A CONFIRMAR com a Minutrade]; enquanto não existir, a conversão %
/// responde "indisponível" (RN44), jamais um número aproximado.
enum NivelAtribuicao {
  POR_OFERTA
  POR_PUBLICO
}

/// Formato de peça — lista de domínio nova (ficha §6), com seed
/// e-mail · banner · push · WhatsApp. Nasce como tabela porque a F10
/// (Parametrizador, Onda 3) ainda não está na main; quando aquela trilha
/// chegar, a T16 passa a editá-la sem migração — o mesmo padrão das
/// demais taxonomias deste schema.
model FormatoPeca {
  id       String   @id @default(cuid())
  slug     String   @unique
  nome     String
  ordem    Int
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  pecas PecaCampanha[]

  @@map("formatos_peca")
}

model Campanha {
  id                String                @id @default(cuid())
  nome              String
  objetivo          String?
  /// Público: a regra declarativa (mesmo formato do Segmento, RN33) fica
  /// aqui; copiar de um segmento salvo NÃO cria vínculo de edição — a
  /// campanha passa a ter a regra dela.
  origemPublico     OrigemPublicoCampanha @default(SEGMENTO_SALVO)
  segmentoId        String?               @map("segmento_id")
  regrasPublico     Json?                 @map("regras_publico")
  /// Snapshot do público congelado na ativação (RN38): a exportação
  /// auditada da F11, com autor, data, contagem e finalidade.
  publicoSnapshotId String?               @unique @map("publico_snapshot_id")
  vigenciaInicio    DateTime?             @map("vigencia_inicio") @db.Date
  vigenciaFim       DateTime?             @map("vigencia_fim") @db.Date
  /// Instruções à operação da Minutrade — viajam no kit.
  instrucoes        String?
  estado            EstadoCampanha        @default(RASCUNHO)
  ativadaEm         DateTime?             @map("ativada_em")
  encerradaEm       DateTime?             @map("encerrada_em")
  autorId           String                @map("autor_id")
  criadoEm          DateTime              @default(now()) @map("criado_em")
  atualizadoEm      DateTime              @updatedAt @map("atualizado_em")

  autor           Usuario          @relation(fields: [autorId], references: [id])
  segmento        Segmento?        @relation(fields: [segmentoId], references: [id])
  publicoSnapshot ExportacaoLista? @relation(fields: [publicoSnapshotId], references: [id])

  cestas            CampanhaCesta[]
  ofertasAvulsas    CampanhaOferta[]
  pecas             PecaCampanha[]
  metas             MetaCampanha[]
  kits              KitCampanha[]
  ofertasDestinadas Oferta[]         @relation("ofertasDestinadas")

  @@index([estado])
  @@map("campanhas")
}

/// Cesta: conjunto nomeado e REUTILIZÁVEL de ofertas (ficha §3), com
/// narrativa e indicação de perfil-alvo. O perfil-alvo alimenta o
/// matching assistivo da RN42 — nunca uma aplicação automática.
model Cesta {
  id           String                @id @default(cuid())
  nome         String
  narrativa    String?
  /// Perfil-alvo: segmento salvo OU regra declarativa própria, mesma
  /// escolha da campanha.
  origemPerfil OrigemPublicoCampanha @default(SEGMENTO_SALVO)
  segmentoId   String?               @map("segmento_id")
  regrasPerfil Json?                 @map("regras_perfil")
  autorId      String                @map("autor_id")
  criadoEm     DateTime              @default(now()) @map("criado_em")
  atualizadoEm DateTime              @updatedAt @map("atualizado_em")

  autor    Usuario   @relation(fields: [autorId], references: [id])
  segmento Segmento? @relation(fields: [segmentoId], references: [id])

  ofertas           CestaOferta[]
  campanhas         CampanhaCesta[]
  ofertasDestinadas Oferta[]        @relation("ofertasDestinadas")

  @@map("cestas")
}

model CestaOferta {
  cestaId  String   @map("cesta_id")
  ofertaId String   @map("oferta_id")
  ordem    Int      @default(0)
  criadoEm DateTime @default(now()) @map("criado_em")

  cesta  Cesta  @relation(fields: [cestaId], references: [id], onDelete: Cascade)
  oferta Oferta @relation(fields: [ofertaId], references: [id])

  @@id([cestaId, ofertaId])
  @@index([ofertaId])
  @@map("cesta_ofertas")
}

model CampanhaCesta {
  campanhaId String   @map("campanha_id")
  cestaId    String   @map("cesta_id")
  ordem      Int      @default(0)
  criadoEm   DateTime @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  cesta    Cesta    @relation(fields: [cestaId], references: [id])

  @@id([campanhaId, cestaId])
  @@index([cestaId])
  @@map("campanha_cestas")
}

/// Ofertas avulsas da campanha — as que entram sem passar por cesta.
model CampanhaOferta {
  campanhaId String   @map("campanha_id")
  ofertaId   String   @map("oferta_id")
  ordem      Int      @default(0)
  criadoEm   DateTime @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  oferta   Oferta   @relation(fields: [ofertaId], references: [id])

  @@id([campanhaId, ofertaId])
  @@index([ofertaId])
  @@map("campanha_ofertas")
}

/// Peça criativa da campanha (RN39): viaja no kit, nunca é disparada
/// daqui. A imagem vai ao armazenamento de objetos (S3; adapter local em
/// desenvolvimento e teste), como o CSV da exportação da F11.
model PecaCampanha {
  id           String   @id @default(cuid())
  campanhaId   String   @map("campanha_id")
  formatoId    String   @map("formato_id")
  titulo       String
  texto        String?
  imagemChave  String?  @map("imagem_chave")
  imagemNome   String?  @map("imagem_nome")
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  campanha Campanha    @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  formato  FormatoPeca @relation(fields: [formatoId], references: [id])

  @@index([campanhaId])
  @@map("pecas_campanha")
}

model MetaCampanha {
  id         String           @id @default(cuid())
  campanhaId String           @map("campanha_id")
  tipo       TipoMetaCampanha
  /// Alvo numérico; para CONVERSAO_PCT é o percentual pretendido.
  alvo       Decimal          @db.Decimal(12, 2)
  criadoEm   DateTime         @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, tipo])
  @@map("metas_campanha")
}

/// Kit de execução — VERSIONADO E IMUTÁVEL (RN45). Nada aqui é atualizado
/// depois de gravado: ajuste pós-ativação gera a versão seguinte com o
/// diff textual em relação à anterior, tudo auditado. O formato definitivo
/// de entrega à Minutrade está [A CONFIRMAR] — ver KitAdapter.
model KitCampanha {
  id           String   @id @default(cuid())
  campanhaId   String   @map("campanha_id")
  versao       Int
  adapter      String
  /// Manifesto gerado (ofertas/cestas com ids externos, vigências,
  /// naturezas) — a base do diff entre versões.
  manifesto    Json
  arquivoChave String   @map("arquivo_chave")
  hashArquivo  String   @map("hash_arquivo")
  /// Diff textual desta versão em relação à anterior (vazio na v1).
  diffTexto    String?  @map("diff_texto")
  autorId      String   @map("autor_id")
  criadoEm     DateTime @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  autor    Usuario  @relation(fields: [autorId], references: [id])

  @@unique([campanhaId, versao])
  @@map("kits_campanha")
}
