# Banco de dados PostgreSQL (Amazon RDS em produção; local em desenvolvimento)
DATABASE_URL="postgresql://broto:broto@localhost:5432/clube_broto?schema=public"

# Auth.js — segredo de sessão (gerar com: openssl rand -base64 32)
AUTH_SECRET=""

# URL pública da aplicação (necessária para o Auth.js atrás de proxy)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Proteção de dados de PF — Onda 5 (gerar cada uma com: openssl rand -base64 32)
# Chave do HMAC-SHA-256 determinístico do CPF (identidade do assinante e
# junção com a telemetria). Trocá-la re-identifica a base inteira: não girar
# sem plano de recarga.
CPF_HASH_KEY=""
# Chave da cifragem em repouso do CPF (AES-256-GCM; derivada por SHA-256 do
# valor informado). Nunca entra no repositório.
APP_ENCRYPTION_KEY=""
