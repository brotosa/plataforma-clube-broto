# Banco de dados PostgreSQL (Amazon RDS em produção; local em desenvolvimento)
DATABASE_URL="postgresql://broto:broto@localhost:5432/clube_broto?schema=public"

# Auth.js — segredo de sessão (gerar com: openssl rand -base64 32)
AUTH_SECRET=""

# URL pública da aplicação (necessária para o Auth.js atrás de proxy)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Proteção de dados de PF (gerar cada uma com: openssl rand -base64 32)
# CPF_HASH_KEY — chave ÚNICA do HMAC-SHA-256 de CPF de toda a plataforma:
# identidade do assinante (Onda 5) E hash da telemetria (Onda 1/F4), que
# delega ao mesmo serviço. Sem fallback embutido: ambiente sem a chave
# falha alto ao hashear. Trocá-la re-identifica a base inteira e desliga a
# junção telemetria ↔ assinante (RN36): não girar sem plano de recarga.
CPF_HASH_KEY=""
# APP_ENCRYPTION_KEY — chave da cifragem em repouso do CPF (AES-256-GCM;
# derivada por SHA-256 do valor informado). Nunca entra no repositório.
APP_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------
# Dossiê assistido (Onda 2, F8) — geração automática de due diligence
#
# As cinco variáveis abaixo são [A CONFIRMAR TI] e NUNCA são commitadas.
# Sem todas elas o provedor automático fica indisponível com mensagem
# clara na T11 e o dossiê segue sendo inserido manualmente: a plataforma
# não embute chave nem tarifa de teste. Em desenvolvimento, o normal é
# deixá-las vazias.
# ---------------------------------------------------------------------

# Chave da API Anthropic (secret do ambiente/CI; nunca no repositório).
ANTHROPIC_API_KEY=""

# Tetos de gasto em reais. Ao atingir o teto mensal, a geração é bloqueada
# com mensagem; acima do teto por dossiê, a execução nem começa — e é
# interrompida se ultrapassá-lo durante a pesquisa.
DOSSIE_TETO_MENSAL_BRL=""
DOSSIE_CUSTO_MAX_UNITARIO_BRL=""

# Tarifa em reais por milhão de tokens, usada para apurar o custo de cada
# execução. A tabela de preços da Anthropic é em dólar: a conversão (e a
# cotação adotada) é decisão da TI, por isso entra como configuração.
DOSSIE_CUSTO_ENTRADA_BRL_MTOK=""
DOSSIE_CUSTO_SAIDA_BRL_MTOK=""
