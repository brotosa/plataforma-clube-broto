# Banco de dados PostgreSQL (Amazon RDS em produção; local em desenvolvimento)
DATABASE_URL="postgresql://broto:broto@localhost:5432/clube_broto?schema=public"

# Auth.js — segredo de sessão (gerar com: openssl rand -base64 32)
AUTH_SECRET=""

# URL pública da aplicação (necessária para o Auth.js atrás de proxy)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Proteção de dados de PF (gerar cada uma com: openssl rand -base64 32)
# CPF_HASH_KEY — chave ÚNICA do HMAC-SHA-256 de CPF de toda a plataforma:
# identidade do assinante (Onda 5) E hash da telemetria (Onda 1/F4), que
# delega ao mesmo serviço. Sem fallback embutido: ambiente sem a chave
# falha alto ao hashear. Trocá-la re-identifica a base inteira e desliga a
# junção telemetria ↔ assinante (RN36): não girar sem plano de recarga.
CPF_HASH_KEY=""
# APP_ENCRYPTION_KEY — chave da cifragem em repouso do CPF (AES-256-GCM;
# derivada por SHA-256 do valor informado). Nunca entra no repositório.
APP_ENCRYPTION_KEY=""
